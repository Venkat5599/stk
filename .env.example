# Full Solana RPC endpoint, key included. Any provider works; Helius free tier
# covers this comfortably at two getProgramAccounts calls per two minutes.
#   https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=

# Postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgres://stk:CHANGEME@localhost:5432/stk

# API
PORT=3021

# Poller
POLL_ENABLED=1
POLL_INTERVAL_MS=120000
